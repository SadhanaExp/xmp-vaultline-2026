# Optional. Without this, Vaultline keeps demo state in memory
# (fine for local demo; resets on restart). On Vercel, set a hosted
# Postgres URI so state survives between requests.
# DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/vaultline

# Optional Google Calendar + Meet integration for Commercial desk meetings.
# Enable the Google Calendar API, create a service account, and provide its key
# as raw JSON or base64. For Workspace invitations and Meet creation, configure
# domain-wide delegation and impersonate a licensed Workspace user.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Or point at a local service-account key file:
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/service-account.json
# Or use split credentials instead:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_IMPERSONATE=

# Calendar where commercial meetings are created. Share it with the service
# account with "Make changes to events". Defaults to the impersonated user's
# calendar, then SALES_BOOKING_CALENDAR, then "primary".
READY_TO_CONTRACT_CALENDAR_ID=
